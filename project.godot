; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="StinkyDumpsterSurvivors"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
Settings="*res://scripts/autoload/settings.gd"
GameState="*res://scripts/autoload/game_state.gd"
Balance="*res://scripts/autoload/balance.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
PoolManager="*res://scripts/autoload/pool_manager.gd"
Profile="*res://scripts/autoload/profile.gd"
SceneFlow="*res://scripts/autoload/scene_flow.gd"
InputMode="*res://scripts/autoload/input_mode.gd"
Achievements="*res://scripts/autoload/achievements.gd"
SteamService="*res://scripts/autoload/steam_service.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/mode=3
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[gui]

theme/custom="res://assets/ui/theme.tres"

