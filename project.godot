[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="enemy"
2d_physics/layer_3="player_projectile"
2d_physics/layer_4="enemy_projectile"
2d_physics/layer_5="pickup"
2d_physics/layer_6="wall"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0.0392157, 0.0392157, 0.0392157, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[internationalization]

locale/translations=PackedStringArray("res://translations/ui.ru.translation", "res://translations/ui.en.translation")
locale/fallback="ru"
