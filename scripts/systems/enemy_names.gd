static func description(enemy_id: StringName) -> String:
	return TranslationServer.translate(_DESCRIPTIONS.get(enemy_id, "Науке неизвестно. Лучше не выяснять."))   # ключ перевода = русский текст


## Серьёзность врага для цвета имени: 0 обычный, 1 опасный, 2 элита, 3 босс.
const _THREAT: Dictionary[StringName, int] = {
	&"charger": 1, &"bruiser": 1, &"mamka": 1, &"glutton": 1, &"spitter": 1, &"healer": 1, &"blinker": 1, &"shield_bearer": 1, &"mirror": 1,
	&"boss_mega_hamster": 2, &"boss_zakhar": 3, &"boss_minion": 3, &"boss_rat_queen": 2, &"boss_blue_whale": 3, &"boss_roach_king": 2, &"boss_trash_golem": 3, &"boss_pigeon_papa": 3, &"boss_mother_in_law": 3,
}
const THREAT_COLORS: Array[Color] = [
	Color(0.91, 0.91, 0.91), Color(1.0, 0.6, 0.1), Color(1.0, 0.1, 0.25), Color(1.0, 0.0627, 0.94)]


static func threat(enemy_id: StringName) -> int:
	return _THREAT.get(enemy_id, 0)


static func color(enemy_id: StringName) -> Color:
	return THREAT_COLORS[threat(enemy_id)]


static func title(enemy_id: StringName) -> String:
	if Balance.BOSS_NAMES.has(enemy_id):
		return TranslationServer.translate(Balance.BOSS_NAMES[enemy_id])
	return TranslationServer.translate(_TITLES.get(enemy_id, "ХЗ КТО, НО ЖЁСТКО"))
