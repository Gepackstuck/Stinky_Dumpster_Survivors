class_name FlavorText
extends RefCounted
## Случайные подписи для экранов. Каждый раз — другая фраза.

const DEATH_LINES: Array[String] = [
	"Ты умер, как лох",
	"Сдох как хуйло",
	"Подох, как и жил: бесполезно",
	"Тебя убили кальмары в кепках. Позор",
	"Ты даже мусор не смог пережить",
	"Мамка тобой не гордится",
	"Сдох. Никто не заплакал",
	"Рукожоп. Это про тебя",
	"Тебя схавали, а ты и не рыпнулся",
	"Мухи жрут тебя и даже не давятся",
	"Ну и урод. Даже сдохнуть нормально не смог",
	"Ты — корм. Всегда им был",
	"Слабак. Помойка тебя даже не заметила",
	"Обосрался и умер. Классика",
	"Пахнешь трупом, а был просто лохом",
	"Рукалицо. Иди ещё раз, неудачник",
	"Дно. А ты ещё и ниже пробил",
	"Тебя убили кальмарчики. Кальмарчики!",
	"Даже кишки у тебя мерзкие",
	"Хуёво играешь. И жить, кстати, тоже",
]

const WIN_LINES: Array[String] = [
	"Ты выиграл и нахуя?",
	"Выжил. Лучше бы сдох — было бы честнее",
	"Победа. Пахнешь всё равно как говно",
	"Выиграл у помойки. Поздравляю, герой параши",
	"Ну выиграл. Мамка всё равно не гордится",
	"Ура. Теперь иди помойся, вонючка",
]

static var _last_death: int = -1
static var _last_win: int = -1


## Звуки, которые выдаёт игрок при уроне (всплывают над ним).
const HIT_WORDS: Array[String] = ["ПУК!", "ПРДЖ!", "БРЫЗГ!", "ФРРР!", "ХЛЮП!", "БЛЯ!"]  # пока не используется: надписи над игроком убраны


static func random_hit_word() -> String:
	return HIT_WORDS[randi() % HIT_WORDS.size()]


static func random_death() -> String:
	_last_death = _pick(DEATH_LINES, _last_death)
	return DEATH_LINES[_last_death]


## Пока не используется: экран победы появится в Шаге 7.
static func random_win() -> String:
	_last_win = _pick(WIN_LINES, _last_win)
	return WIN_LINES[_last_win]


# Не повторяет предыдущую фразу два раза подряд.
static func _pick(lines: Array[String], last: int) -> int:
	var index: int = randi() % lines.size()
	if index == last:
		index = (index + 1) % lines.size()
	return index
